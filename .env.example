# CoreGrid Scholar environment variables
# Copy to .env for local development. Never commit .env.

# Supabase (project: srhmfaoyhpvhdfxmagho)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key is SERVER-ONLY. Never prefix it with VITE_ (that would
# bundle it into the client).
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI gateway (server-side)
AI_API_KEY=
AI_GATEWAY_URL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=

# Payments (Paystack webhook verification)
PAYSTACK_SECRET_KEY=

# SMS / messaging
TWILIO_API_KEY=
TWILIO_FROM_NUMBER=
TWILIO_GATEWAY_URL=

# E2E tests
PLAYWRIGHT_BASE_URL=http://localhost:8080
