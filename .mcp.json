{
  "mcpServers": {
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "20",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "ruv-swarm": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruv-swarm",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false"
      },
      "optional": true
    },
    "flow-nexus": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "flow-nexus@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false"
      },
      "optional": true,
      "requiresAuth": true
    },
    "github": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      }
    },
    "supabase": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@joshuarileydev/supabase-mcp-server"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "SUPABASE_URL": "https://qimawwdlgjtudzufgeox.supabase.co",
        "SUPABASE_SERVICE_ROLE_KEY": "sb_publishable_2PSAr0311iiJBNWnOs6pNA_yy7SQ8SY"
      }
    }
  }
}